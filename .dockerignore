# Patterns here match from the build context root.

# version control and local planning docs
.git
.private

# dependencies and build output, rebuilt inside the image
node_modules
.next
out
coverage
*.tsbuildinfo

# test artifacts
.vitest
test-results
playwright-report
blob-report

# secrets, the self-hosting .env included
**/.env*
**/*.pem

# misc
.vercel
.DS_Store
npm-debug.log*
.pnpm-debug.log*
