{
  "name": "kotsu",
  "private": true,
  "description": "Open-source workspace for any goal you practise daily",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5687",
    "build": "next build",
    "start": "next start --port 5687",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:browser": "vitest run --project browser --project 'storybook-*'",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project desktop",
    "storybook": "storybook dev --port 6006",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test"
  },
  "dependencies": {
    "@vercel/functions": "3.10.5",
    "drizzle-orm": "1.0.0-rc.5",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@next/env": "16.4.3",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.6.5",
    "jiti": "2.7.0",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.16.1"
}
