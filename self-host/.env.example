# Copy to .env next to compose.yaml and fill in

# The address people open Kotsu at: sign-in, cookies and passkeys are tied to it
APP_URL=http://localhost:3000

# Signs sessions and encrypts sign-in codes; at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The database password; letters and digits only, since it goes into the database URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# Sign-in codes: email them through Resend from an address on a domain you verified there…
RESEND_API_KEY=
EMAIL_FROM=
# …or, with no email set up, print them in `docker compose logs app`
SIGN_IN_CODES_IN_LOG=true

# Continue with Google, optional: an OAuth client whose redirect URI is <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Proxies whose X-Forwarded-For entries are trusted (IPs or CIDR ranges, comma-separated). Needed only when a
# proxy appends to the header instead of replacing it, like nginx with $proxy_add_x_forwarded_for
TRUSTED_PROXIES=

# Room each account gets, in megabytes (1 MB = 1,000,000 bytes). Empty = no limit
STORAGE_QUOTA_MB=
