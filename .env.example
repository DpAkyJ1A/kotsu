# Copy to .env, which git ignores. On Vercel the Neon integration sets these instead.

# Pooled connection for the app; locally the Postgres from `docker compose up -d db`
DATABASE_URL=postgres://kotsu:kotsu@localhost:5433/kotsu
# Direct connection for migrations, when the pooled one goes through PgBouncer (Neon)
# DATABASE_URL_UNPOOLED=
